{
  "name": "shop-api",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/server.js",
    "migrate": "node src/migrate.js",
    "seed": "node src/seed.js",
    "test": "npm run test:db:up --silent && node --test \"test/**/*.test.js\"",
    "test:db:up": "docker compose -f test/compose.yaml up -d --wait --quiet-pull",
    "test:db:down": "docker compose -f test/compose.yaml down -v"
  },
  "dependencies": {
    "pg": "8.23.1"
  }
}
