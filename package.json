{
  "name": "lo1",
  "private": true,
  "license": "Apache-2.0",
  "workspaces": [
    "packages/*",
    "plugins/*"
  ],
  "devDependencies": {
    "@types/bun": "latest",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^9.39.4",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^9.1.2",
    "prettier": "^3.9.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.62.1"
  },
  "overrides": {
    "fast-uri": "3.1.2",
    "flatted": "3.4.2",
    "picomatch": "4.0.4"
  },
  "scripts": {
    "build": "bun run --filter '*' build",
    "test": "bun run --filter '*' test",
    "test:coverage": "bun scripts/check-coverage.ts",
    "lint": "eslint packages/ plugins/",
    "lint:fix": "eslint packages/ plugins/ --fix",
    "lint:report": "eslint packages/ plugins/ -f json -o eslint-report.json || true",
    "format": "prettier --write \"packages/*/src/**/*.ts\" \"plugins/*/src/**/*.ts\"",
    "format:check": "prettier --check \"packages/*/src/**/*.ts\" \"plugins/*/src/**/*.ts\"",
    "typecheck": "bun run --filter '*' typecheck",
    "clean": "bun run --filter '*' clean"
  }
}
